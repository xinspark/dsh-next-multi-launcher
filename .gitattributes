# 统一换行符：仓库内一律 LF，checkout 时按平台转换
* text=auto eol=lf

# Windows 脚本保持 CRLF（PowerShell 对 LF 兼容，但 CRLF 更稳妥）
*.ps1 text eol=crlf

# 二进制：不要让 git 做换行转换，也不要 diff 文本
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.lib binary
*.asar binary
*.db binary
*.zip binary

# 锁文件：diff 无意义
pnpm-lock.yaml -diff
Cargo.lock -diff

# 生成物：标为 linguist-generated，GitHub 上默认折叠
src/styles/tokens.css linguist-generated=true
design/tokens.lock.json linguist-generated=true
